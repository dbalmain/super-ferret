#!/usr/bin/env bash
# Summarises the shadow log that ferret-shadow writes (D118, step 1), for
# deciding whether a day's log is clean enough to let the stand-in rg answer
# from ferret (step 2); usage: ferret-shadow-report [--since YYYY-MM-DD]
#
# Prints the count of each verdict, then every call that needs a look
# (differ and rejected), grouped by the shape of its argv: options kept,
# their values and the operands replaced by X, so one cause is listed once
# however many patterns hit it. Each group shows its newest call as a command
# that replays it, and the kept runs under mismatch/ whose argv it shares.
#
# Exit status: 0 when nothing needs a look, 1 when something does, 2 when
# there is no log.
#
# Environment:
#   FERRET_SHADOW_DIR   as for ferret-shadow
#                       (default: $XDG_STATE_HOME/ferret/shadow)

set -u
state=${FERRET_SHADOW_DIR:-${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/ferret/shadow}
since=
case ${1:-} in
    --since)
        since=${2:?--since needs a date}
        ;;
    '') ;;
    *)
        echo "usage: ferret-shadow-report [--since YYYY-MM-DD]" >&2
        exit 2
        ;;
esac

logs=()
for file in "$state/log.1" "$state/log"; do
    [[ -f $file ]] && logs+=("$file")
done
if ((${#logs[@]} == 0)); then
    echo "no shadow log under $state" >&2
    exit 2
fi

# The kept runs, one "argv TAB directory" line each; ferret-shadow writes
# argv in the same quoting as the log's last field.
kept=$(mktemp)
trap 'rm -f "$kept"' EXIT
for dir in "$state"/mismatch/*/; do
    [[ -f $dir/argv ]] && printf '%s\t%s\n' "$(< "$dir/argv")" "${dir%/}" >> "$kept"
done

LC_ALL=C awk -F '\t' -v since="$since" -v kept="$kept" '
# rg options that take a value as the next argument; the value is not part
# of the shape.
BEGIN {
    split("-e -f -g -m -t -T -A -B -C -E -M -j -r --regexp --file --glob " \
        "--iglob --type --type-not --type-add --type-clear --max-count " \
        "--after-context --before-context --context --encoding " \
        "--max-columns --threads --replace --max-depth --maxdepth " \
        "--max-filesize --sort --sortr --pre --pre-glob --color --colors " \
        "--context-separator --field-context-separator " \
        "--field-match-separator --path-separator --engine --dfa-size-limit " \
        "--regex-size-limit --ignore-file --hostname-bin --hyperlink-format",
        names, " ")
    for (i in names) valued[names[i]] = 1
    while ((getline line < kept) > 0) {
        split(line, field, "\t")
        keptdir[field[1]] = field[2]
    }
}
since != "" && substr($1, 1, 10) < since { next }
{
    calls++
    if (first == "") first = $1
    last = $1
    verdict = $2
    family = verdict
    sub(/:.*/, "", family)
    if (family == "rejected") count[family]++; else count[verdict]++
    if (family != "differ" && family != "rejected") next

    # The argv field is shell-quoted words, each followed by a space; an
    # escaped space belongs to its word.
    argv = $6
    gsub(/\\ /, "\001", argv)
    n = split(argv, words, " ")
    shape = ""
    after = 0
    for (i = 1; i <= n; i++) {
        word = words[i]
        if (word == "") continue
        if (after) { word = "X"; after = 0 }
        else if (word == "--") { }
        else if (word ~ /^--[^=]+=/) { sub(/=.*/, "=X", word) }
        else if (word ~ /^-/) { if (word in valued) after = 1 }
        else word = "X"
        shape = shape (shape == "" ? "" : " ") word
    }
    key = verdict "\t" shape
    if (!(key in seen)) order[++groups] = key
    seen[key]++
    newest[key] = "cd " $5 " && rg " $6
    when[key] = $1
    if ($6 in keptdir && index(" " dirs[key] " ", " " keptdir[$6] " ") == 0)
        dirs[key] = dirs[key] (dirs[key] == "" ? "" : " ") keptdir[$6]
}
END {
    if (calls == 0) {
        print "no calls in the shadow log" (since == "" ? "" : " since " since)
        exit 0
    }
    printf "%d calls, %s to %s\n\n", calls, first, last
    for (v in count) printf "%8d  %s\n", count[v], v | "sort -k2"
    close("sort -k2")
    if (groups == 0) { print "\nnothing needs a look"; exit 0 }
    printf "\nneeds a look:\n"
    for (g = 1; g <= groups; g++) {
        key = order[g]
        split(key, part, "\t")
        printf "\n%d x %s\n  shape:  %s\n  newest: %s\n  replay: %s\n",
            seen[key], part[1], part[2], when[key], newest[key]
        if (dirs[key] != "") printf "  kept:   %s\n", dirs[key]
    }
    exit 1
}
' "${logs[@]}"
