#!/usr/bin/env bash
# Compares one rg command with `ferret grep` (D118, step 1). Started detached
# by the stand-in `rg` beside it, after which that script execs the real rg
# for its caller; usage: ferret-shadow REAL_RG ARG...
#
# Both run here, one after the other, with stdin from /dev/null, so they see
# the same input and nearly the same tree. Nothing here reaches the caller,
# and nothing it writes is under a path the caller searches.
#
# Environment:
#   FERRET_BIN          ferret (default: ferret on PATH)
#   FERRET_SHADOW_DIR   log and kept mismatches
#                       (default: $XDG_STATE_HOME/ferret/shadow)
#   FERRET_SHADOW_STDIN 1 when the caller's stdin could be read (set by `rg`)
#
# One log line per call, tab-separated: time, verdict, rg exit, ferret exit,
# cwd, argv. cwd and argv are shell-quoted, so a line can be replayed. The log
# moves to log.1 past 16 MiB, and the newest 100 mismatches are kept.
# Verdicts:
#   agree      same exit status, same stdout records in any order, and
#              diagnostics from both or neither
#   lag        differed, then agreed when both ran again two seconds later
#   known:git  `--files --hidden` differed only by rg listing .git, which the
#              index leaves out (docs/GREP.md)
#   differ     still differed; both runs are kept under mismatch/
#   rejected:MESSAGE  ferret grep refused the command (exit 2)
#   skipped:WHY  not compared: busy (another comparison is running), stdin
#              (the command reads it), info (--help, --version), effects
#              (it runs a program), config (RIPGREP_CONFIG_PATH is set), large
#              (over 64 MiB), slow (over two minutes), setup
# A command that searches this script's own directories is not compared or
# logged: the caller's rg may still be reading them.
#
# An `agree` is a screen, not proof: order within a file and diagnostic text
# are not compared. Step 2 replays the log through the ordered differential.

umask 077
real=$1
shift
args=("$@")
ferret=${FERRET_BIN:-ferret}
state=${FERRET_SHADOW_DIR:-${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/ferret/shadow}
scratch=${XDG_RUNTIME_DIR:-$state}

# Reads argv as rg does: which options take a value, short options bundled,
# and operands after `--`. Sets the flags below and `operands`, the paths.
# --files, --count, --files-with-matches and --json override one another, the
# last one winning, so `mode` holds the last: files, count, names, json or
# lines.
mode=lines null=0 hidden=0 unrestricted=0 sources=0 why=
operands=()
value_short=ABCdEefgjMmrtT
value_long=' regexp file pre pre-glob dfa-size-limit encoding engine max-count
    regex-size-limit threads glob iglob ignore-file max-depth max-filesize type
    type-not type-add type-clear after-context before-context color colors
    context context-separator field-context-separator field-match-separator
    hostname-bin hyperlink-format max-columns path-separator replace sort
    sortr generate '
value_long=${value_long//$'\n'/ }

# One option and its value, if it takes one.
option() {
    case $1 in
        e | regexp) sources=1 ;;
        f | file)
            sources=1
            if [[ $2 == - ]]; then why=stdin; fi
            ;;
        pre | hostname-bin) why=${why:-effects} ;;
        h | help | V | version) why=${why:-info} ;;
        json) mode=json ;;
        no-json) if [[ $mode == json ]]; then mode=lines; fi ;;
        files) mode=files ;;
        c | count | count-matches) mode=count ;;
        l | files-with-matches | files-without-match) mode=names ;;
        0 | null) null=1 ;;
        . | hidden) hidden=1 ;;
        no-hidden) hidden=0 ;;
        u)
            unrestricted=$((unrestricted + 1))
            if ((unrestricted == 2)); then hidden=1; fi
            ;;
    esac
}

i=0
while ((i < ${#args[@]})); do
    arg=${args[i]}
    i=$((i + 1))
    case $arg in
        --)
            operands+=("${args[@]:i}")
            break
            ;;
        --*=*)
            name=${arg%%=*}
            option "${name:2}" "${arg#*=}"
            ;;
        --?*)
            name=${arg:2}
            if [[ $value_long == *" $name "* ]]; then
                option "$name" "${args[i]-}"
                i=$((i + 1))
            else
                option "$name" ""
            fi
            ;;
        -?*)
            for ((j = 1; j < ${#arg}; j++)); do
                c=${arg:j:1}
                if [[ $value_short == *"$c"* ]]; then
                    value=${arg:j+1}
                    if [[ -z $value ]]; then
                        value=${args[i]-}
                        i=$((i + 1))
                    fi
                    option "$c" "$value"
                    break
                fi
                option "$c" ""
            done
            ;;
        *) operands+=("$arg") ;;
    esac
done
json=0 files=0 names=0
case $mode in
    json) json=1 ;;
    files) files=1 ;;
    names) names=1 ;;
esac
if ((!sources && !files)); then
    operands=("${operands[@]:1}")
fi
for operand in "${operands[@]}"; do
    if [[ $operand == - ]]; then
        why=stdin
    fi
done
# A listing never reads stdin.
if ((${#operands[@]} == 0 && !files)) && [[ ${FERRET_SHADOW_STDIN:-0} == 1 ]]; then
    why=stdin
fi

# Would the caller's search walk into our own files? Then stay out entirely:
# even a log line could land in its results.
inside() {
    local here there
    there=$(realpath -m -- "$1")
    for here in "${operands[@]:-.}"; do
        here=$(realpath -m -- "$here") || continue
        if [[ $there == "$here" || $there == "${here%/}"/* ]]; then
            return 0
        fi
    done
    return 1
}
if inside "$state" || inside "$scratch"; then
    exit 0
fi

mkdir -p "$state" || exit 0
# Opening anything but a file could block, as a FIFO with no reader does.
for file in log lock; do
    if [[ -e $state/$file && ! -f $state/$file ]]; then
        exit 0
    fi
done

log() {
    if [[ $(stat -c %s "$state/log" 2> /dev/null) -gt $((16 << 20)) ]]; then
        mv -f "$state/log" "$state/log.1"
    fi
    printf '%s\t%s\t%s\t%s\t%q\t%s\n' "$(date +%FT%T%z)" "$1" "$2" "$3" "$PWD" \
        "$(printf '%q ' "${args[@]}")" >> "$state/log"
}

# The replay would run rg with a configuration ferret grep refuses, and that
# may name a --pre program.
if [[ -n ${RIPGREP_CONFIG_PATH:-} ]]; then
    why=${why:-config}
fi
if [[ -n $why ]]; then
    log "skipped:$why" - -
    exit 0
fi

renice -n 19 $$ > /dev/null 2>&1
ionice -c 3 -p $$ > /dev/null 2>&1

# One comparison at a time. The lock is this shell's alone: every command
# below runs with descriptor 9 closed, so no child, and no daemon a child
# starts, can keep it.
exec 9> "$state/lock" || exit 0
if ! flock -n 9; then
    log skipped:busy - -
    exit 0
fi

run=$(mktemp -d "$scratch/ferret-shadow.XXXXXX") || {
    log skipped:setup - -
    exit 0
}
trap 'rm -rf "$run"' EXIT

# Runs one side into $run/NAME.out and NAME.err; 64 MiB of output at most
# (bash counts ulimit -f in KiB).
side() {
    local name=$1
    shift
    (
        ulimit -f $((64 * 1024))
        exec timeout -k 5 120 "$@" < /dev/null > "$run/$name.out" 2> "$run/$name.err" 9>&-
    )
}

# Output records in any order: rg's worker threads finish files in any order.
# `-0` with a listing ends records with NUL. JSON drops elapsed times and the
# summary, which counts files read, and an index reads fewer.
if ((null && (files || names))); then
    split=-z
else
    split=
fi
normal() {
    if ((json)); then
        sed -E '/^\{"(type":"summary"|data":\{"elapsed_total")/d; /^\{"type":"end"/s/"elapsed":\{[^}]*\}//' "$1" |
            LC_ALL=C sort
    else
        LC_ALL=C sort $split "$1"
    fi
}

compare() {
    side rg "$real" "${args[@]}"
    echo $? > "$run/rg.status"
    FERRET_STALE_NOTICE=0 side ferret "$ferret" grep "${args[@]}"
    echo $? > "$run/ferret.status"
}

verdict() {
    local rg ferret rs fs same=agree
    rg=$(< "$run/rg.status") ferret=$(< "$run/ferret.status")
    case "$rg $ferret" in
        124\ * | *\ 124 | 137\ * | *\ 137)
            echo skipped:slow
            return
            ;;
        153\ * | *\ 153)
            echo skipped:large
            return
            ;;
    esac
    if ((ferret == 2 && rg != 2)); then
        echo "rejected:$(head -n 1 "$run/ferret.err" | head -c 200 | tr '\t' ' ')"
        return
    fi
    if [[ $rg != "$ferret" ]]; then
        echo differ
        return
    fi
    if ! cmp -s <(normal "$run/rg.out") <(normal "$run/ferret.out"); then
        if ((files && hidden)) &&
            cmp -s <(LC_ALL=C grep -a $split -Ev '(^|/)\.git(/|$)' "$run/rg.out" | LC_ALL=C sort $split) \
                <(normal "$run/ferret.out"); then
            same=known:git
        else
            echo differ
            return
        fi
    fi
    if [[ -s $run/rg.err ]]; then rs=1; else rs=0; fi
    if [[ -s $run/ferret.err ]]; then fs=1; else fs=0; fi
    if ((rs != fs)); then
        echo differ
        return
    fi
    echo $same
}

compare 9>&-
first=$(verdict 9>&-)
case $first in
    agree | known:git | skipped:* | rejected:*)
        log "$first" "$(< "$run/rg.status")" "$(< "$run/ferret.status")"
        exit 0
        ;;
esac
statuses=("$(< "$run/rg.status")" "$(< "$run/ferret.status")")
mkdir -p "$run/first"
mv "$run"/*.out "$run"/*.err "$run"/*.status "$run/first/"
sleep 2
compare 9>&-
again=$(verdict 9>&-)
if [[ $again == agree || $again == known:git ]]; then
    log lag "${statuses[@]}"
    exit 0
fi
log "$first" "${statuses[@]}"
if [[ $first == differ ]]; then
    keep=$state/mismatch/$(date +%Y%m%dT%H%M%S)-$$
    mkdir -p "$keep" && mv "$run"/* "$keep/"
    printf '%q ' "${args[@]}" > "$keep/argv"
    printf '%q\n' "$PWD" > "$keep/cwd"
    find "$state/mismatch" -mindepth 1 -maxdepth 1 -print0 | LC_ALL=C sort -rz |
        tail -zn +101 | xargs -0r rm -rf --
fi
