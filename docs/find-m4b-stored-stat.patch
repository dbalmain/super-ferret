     pub(super) fn evaluate(&self, entry: &Entry) -> std::io::Result<bool> {
+        if let Some((size, stamp)) = entry.stored_stat() {
+            match self {
+                Self::Size { units, bytes } => {
+                    return Ok(compare(
+                        size.div_ceil(*bytes),
+                        units.value as u64,
+                        units.order,
+                    ));
+                }
+                Self::Time {
+                    field: TimeField::Modify,
+                    age,
+                    now,
+                    daystart: false,
+                    minutes: false,
+                } if age.value.fract() == 0.0 => {
+                    let now = now.duration_since(UNIX_EPOCH).unwrap_or_default().as_secs() as i64;
+                    return Ok(compare_float(
+                        (now - stamp).div_euclid(86_400) as f64,
+                        age.value,
+                        age.order,
+                    ));
+                }
+                _ => {}
+            }
+        }
         let stat = entry
             .metadata()
             .map_err(|e| std::io::Error::new(e.kind(), e.to_string()))?;
